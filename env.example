# コピーして env として読む: cp env.example env && source ./env
export AWS_PROFILE=your-profile
export AWS_REGION=ap-northeast-1
# crew 名(英小文字・数字・ハイフン、32 文字以内)。~/.kiro/agents/<CREW_NAME>.json が必要
export CREW_NAME=fargate-demo
# ECR リポジトリ名(作られる)
export ECR_REPO=kirocrew-crew
# Crew のサインインに使う IAM Identity Center の Start URL とリージョン(Builder ID なら空)
export KIRO_START_URL=https://xxxxxxxx.awsapps.com/start
export KIRO_IDP_REGION=us-east-1
# ハブ(手元の kirocrew gateway)のポート
export KIROCREW_PORT=5476
# Fargate のタスク寿命(秒)と MicroVM の寿命(秒)
export FARGATE_TASK_TTL=3600
export MICROVM_WALL_SECONDS=3600
